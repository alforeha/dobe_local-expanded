                "default_target": 50.0,
                "unit": "g",
                "metric_type": "target"
            },
            {
                "id": "NUT_MIN_SOD",
                "display_name": "Sodium",
                "axis_group": "Minerals",
                "default_target": 2300.0,
                "unit": "mg",
                "metric_type": "upper_limit"
            },
            {
                "id": "NUT_MIN_POT",
                "display_name": "Potassium",
                "axis_group": "Minerals",
                "default_target": 4700.0,
                "unit": "mg",
                "metric_type": "target"
            },
            {
                "id": "NUT_MIN_CAL",
                "display_name": "Calcium",
                "axis_group": "Minerals",
                "default_target": 1300.0,
                "unit": "mg",
                "metric_type": "target"
