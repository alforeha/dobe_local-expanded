{
    "schema_metadata": {
        "purpose": "App Unified Radar Chart and Meal Analytics Data Architecture",
        "version": "1.0.0",
        "dimensions": {
            "radar_1_nutrients": "Essential Daily Values (Target vs. Upper Limit)",
            "radar_2_food_groups": "Dietary Servings / Group Portions Mapping"
        }
    },
    "radar_chart_dimensions": {
        "nutrient_targets": [
            {
                "id": "NUT_MAC_FAT",
                "display_name": "Total Fat",
                "axis_group": "Macronutrients",
                "default_target": 78.0,
                "unit": "g",
                "metric_type": "upper_limit"
            },
            {
                "id": "NUT_MAC_SATFAT",
                "display_name": "Saturated Fat",
                "axis_group": "Macronutrients",
                "default_target": 20.0,
                "unit": "g",
                "metric_type": "upper_limit"
            },
            {
                "id": "NUT_MAC_CARB",
                "display_name": "Total Carbohydrates",
                "axis_group": "Macronutrients",
                "default_target": 275.0,
                "unit": "g",
                "metric_type": "target"
            },
            {
                "id": "NUT_MAC_FIBER",
                "display_name": "Dietary Fiber",
                "axis_group": "Macronutrients",
                "default_target": 28.0,
                "unit": "g",
                "metric_type": "target"
            },
            {
                "id": "NUT_MAC_SUGAR",
                "display_name": "Added Sugars",
                "axis_group": "Macronutrients",
                "default_target": 50.0,
                "unit": "g",
                "metric_type": "upper_limit"
            },
            {
                "id": "NUT_MAC_PROT",
                "display_name": "Protein",
